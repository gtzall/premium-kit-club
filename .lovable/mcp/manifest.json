{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://zlqfrgyporsopirzjyzu.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "gn-football-mcp",
      "version": "0.2.0",
      "title": "GN Football"
    },
    "tools": [
      {
        "name": "list_products",
        "title": "List products",
        "description": "List active jerseys in the GN Football catalog. Optionally filter by category (e.g. 'retro', 'europeu', 'brasileiro') or featured only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "Optional category slug filter.",
              "type": "string"
            },
            "featured": {
              "description": "If true, return only featured products.",
              "type": "boolean"
            },
            "limit": {
              "description": "Max rows to return (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Get product",
        "description": "Fetch a single product by slug or id, including price, stock, sizes, and description.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug_or_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9_-]+$",
              "description": "The product slug or id."
            }
          },
          "required": [
            "slug_or_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "my_profile",
        "title": "My profile",
        "description": "Return the signed-in user's GN Football profile, roles (admin/vip), and VIP status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "update_profile",
        "title": "Update profile",
        "description": "Update the signed-in user's GN Football profile fields (full_name only). Role, email and purchased counters are protected.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "full_name": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80,
              "pattern": "^[\\p{L}\\p{M} '.\\-]+$",
              "description": "Display name shown on the account."
            }
          },
          "required": [
            "full_name"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_cart",
        "title": "Get cart",
        "description": "Return the signed-in user's saved cart items with product details and subtotal.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "add_to_cart",
        "title": "Add to cart",
        "description": "Add a product (by id) to the signed-in user's cart. If the item + size already exists, the quantity is incremented.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "product_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9_-]+$",
              "description": "Product id."
            },
            "size": {
              "default": "M",
              "type": "string",
              "enum": [
                "P",
                "M",
                "G",
                "GG"
              ]
            },
            "qty": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "product_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "remove_from_cart",
        "title": "Remove from cart",
        "description": "Remove a specific cart item by its id, or clear the whole cart when clear_all=true.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "item_id": {
              "description": "Cart item id to remove.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "clear_all": {
              "description": "If true, remove all items from the cart.",
              "type": "boolean"
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
