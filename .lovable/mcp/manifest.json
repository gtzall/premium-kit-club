{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://zlqfrgyporsopirzjyzu.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "gn-football-mcp",
      "version": "0.1.0",
      "title": "GN Football"
    },
    "tools": [
      {
        "name": "list_products",
        "title": "List products",
        "description": "List active jerseys in the GN Football catalog. Optionally filter by category (e.g. 'retro', 'europeu', 'brasileiro') or featured only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "Optional category slug filter.",
              "type": "string"
            },
            "featured": {
              "description": "If true, return only featured products.",
              "type": "boolean"
            },
            "limit": {
              "description": "Max rows to return (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Get product",
        "description": "Fetch a single product by slug or id, including price, stock, sizes, and description.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug_or_id": {
              "type": "string",
              "description": "The product slug or id."
            }
          },
          "required": [
            "slug_or_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "my_profile",
        "title": "My profile",
        "description": "Return the signed-in user's GN Football profile, roles (admin/vip), and VIP status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
